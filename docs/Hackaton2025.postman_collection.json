		{
			"name": "Retorna valores simulados por produto em cada dia",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"const today = new Date();\r",
							"const yyyy = today.getFullYear();\r",
							"const mm = String(today.getMonth() + 1).padStart(2, '0');\r",
							"const dd = String(today.getDate()).padStart(2, '0');\r",
							"const formattedDate = `${yyyy}-${mm}-${dd}`;\r",
							"pm.environment.set('data', formattedDate);"
						],
						"type": "text/javascript",
						"packages": {}
					}
				},
