	"item": [
		{
			"name": "Gerar Token de Autorização",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// Testa se foi bem sucedido\r",
							"pm.test(\"Token generation successful\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"// Extrai a reposta em uma variavel\r",
							"if (pm.response.code === 200) {\r",
							"    const responseJson = pm.response.json();\r",
							"    const token = responseJson.token;\r",
							"    \r",
							"    // Seta nas variaveis de ambiente\r",
							"    pm.environment.set(\"bearer_token\", token);\r",
							"}"
						],
						"type": "text/javascript",
						"packages": {}
					}
				},
				{
					"listen": "prerequest",
					"script": {
						"exec": [],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\r\n    \"usuario\": \"hackathon\",\r\n    \"password\": \"2025\"\r\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": "{{localHost}}/auth/token"
			},
			"response": []
		},
		{
			"name": "Realiza uma simulação de crédito",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"// Definicoes do produto\r",
							"const products = [\r",
							"  {\r",
							"    id: 1,\r",
							"    minPrazo: 0,\r",
							"    maxPrazo: 24,\r",
							"    minValor: 200.00,\r",
							"    maxValor: 10000.00\r",
							"  },\r",
							"  {\r",
							"    id: 2,\r",
							"    minPrazo: 25,\r",
							"    maxPrazo: 48,\r",
							"    minValor: 10001.00,\r",
							"    maxValor: 100000.00\r",
							"  },\r",
							"  {\r",
							"    id: 3,\r",
							"    minPrazo: 49,\r",
							"    maxPrazo: 96,\r",
							"    minValor: 100000.01,\r",
							"    maxValor: 1000000.00\r",
							"  },\r",
							"  {\r",
							"    id: 4,\r",
							"    minPrazo: 96,\r",
							"    maxPrazo: 120, // Arbitrary upper bound for null\r",
							"    minValor: 1000000.01,\r",
							"    maxValor: 2000000.00 // Arbitrary upper bound for null\r",
							"  }\r",
							"];\r",
							"\r",
							"// Pegue um produto qualquer\r",
							"const product = products[Math.floor(Math.random() * products.length)];\r",
							"\r",
							"// Gerar prazo e valorDesejado dentro dos limites do produto\r",
							"const prazo = Math.floor(Math.random() * (product.maxPrazo - product.minPrazo + 1)) + product.minPrazo;\r",
							"const valorDesejado = (Math.random() * (product.maxValor - product.minValor) + product.minValor).toFixed(2);\r",
							"\r",
							"// Setar variaveis para a resposta\r",
							"pm.environment.set(\"prazo\", prazo);\r",
							"pm.environment.set(\"valorDesejado\", valorDesejado);"
						],
						"type": "text/javascript",
						"packages": {}
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"auth": {
					"type": "bearer",
					"bearer": {
						"token": "{{bearer_token}}"
					}
				},
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\r\n  \"valorDesejado\": {{valorDesejado}},\r\n  \"prazo\": {{prazo}}\r\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": "{{localHost}}/simulacoes"
			},
			"response": []
		},
