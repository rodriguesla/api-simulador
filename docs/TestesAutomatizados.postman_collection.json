					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"// Product definitions\r",
									"const products = [\r",
									"  {\r",
									"    id: 1,\r",
									"    minPrazo: 0,\r",
									"    maxPrazo: 24,\r",
									"    minValor: 200.00,\r",
									"    maxValor: 10000.00\r",
									"  },\r",
									"  {\r",
									"    id: 2,\r",
									"    minPrazo: 25,\r",
									"    maxPrazo: 48,\r",
									"    minValor: 10001.00,\r",
									"    maxValor: 100000.00\r",
									"  },\r",
									"  {\r",
									"    id: 3,\r",
									"    minPrazo: 49,\r",
									"    maxPrazo: 96,\r",
									"    minValor: 100000.01,\r",
									"    maxValor: 1000000.00\r",
									"  },\r",
									"  {\r",
									"    id: 4,\r",
									"    minPrazo: 96,\r",
									"    maxPrazo: 120, // Arbitrary upper bound for null\r",
									"    minValor: 1000000.01,\r",
									"    maxValor: 2000000.00 // Arbitrary upper bound for null\r",
									"  }\r",
									"];\r",
									"\r",
									"// Pick a random product\r",
									"const product = products[Math.floor(Math.random() * products.length)];\r",
									"\r",
									"// Generate random prazo and valorDesejado within product limits\r",
									"const prazo = Math.floor(Math.random() * (product.maxPrazo - product.minPrazo + 1)) + product.minPrazo;\r",
									"const valorDesejado = (Math.random() * (product.maxValor - product.minValor) + product.minValor).toFixed(2);\r",
									"\r",
									"// Set variables for request body\r",
									"pm.environment.set(\"prazo\", prazo);\r",
									"pm.environment.set(\"valorDesejado\", valorDesejado);"
								],
								"type": "text/javascript",
								"packages": {}
							}
